{
  "name": "ooxmlgen",
  "version": "1.0.0",
  "description": "OOXML generation library — Professional DOCX documents with advanced Word features",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "CAPABILITY_MATRIX.md",
    "API_CLASSIFICATION.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate": "ts-node --project tsconfig.test.json examples/generate.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "docx",
    "ooxml",
    "word",
    "document",
    "wordprocessingml",
    "ecma-376",
    "typescript",
    "pdf",
    "office",
    "microsoft-office",
    "word-document",
    "arabic",
    "rtl",
    "right-to-left",
    "internationalization"
  ],
  "author": "Karim Tiarti <karim.tiarti@hotmail.com>",
  "license": "ISC",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/krimoudz14/ooxmlgen.git"
  },
  "homepage": "https://github.com/krimoudz14/ooxmlgen#readme",
  "bugs": {
    "url": "https://github.com/krimoudz14/ooxmlgen/issues"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  }
}
